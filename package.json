{
  "name": "arcanitebrothers",
  "author": "Babuni.dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:ui": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser.spec.mjs",
    "test:integration": "node --test tests/integration.spec.mjs",
    "test:postgres": "node --test tests/postgres.spec.mjs",
    "test:browser:content": "node --test tests/browser-content.spec.mjs",
    "test:connections": "node --test tests/connections.test.mjs tests/keyring.test.mjs tests/local-service.test.mjs tests/morkahja-ssh.test.mjs",
    "credentials": "node --experimental-strip-types scripts/credentials.mjs",
    "test:browser:connections": "node --test tests/browser-connections.spec.mjs",
    "keyring:verify": "node --experimental-strip-types scripts/verify-keyring.mjs",
    "morkahja:configure": "node --experimental-strip-types scripts/configure-morkahja-db.mjs",
    "morkahja:content-grant": "node --experimental-strip-types scripts/authorize-morkahja-content.mjs",
    "test:content:scoped": "node --experimental-strip-types --test tests/scoped-content.spec.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pg": "^8.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
