# Morkahja local admin is disabled unless explicitly enabled.
# Never put credentials into VITE_-prefixed values.
# DATABASE_URL=postgresql://admin:REPLACE_ME@127.0.0.1:5433/morkahja
# VITE_USE_LOCAL_POSTGRES=true
# Local game assets and their edit endpoints require both flags:
# VITE_USE_LOCAL_CONTENT=true
# LOCAL_CONTENT_WRITES=true
# MORKAHJA_PUBLIC=/path/to/MorkahjaWebApp/client/public
# Remote API proxy (requires separate server authentication before use):
# VITE_API_BASE_URL=/game-data/admin
# LOCAL_ADMIN_PROXY_ENABLED=true # requires explicit opt-in; not a production security boundary
# API_PROXY_TARGET=https://example.invalid
# ADMIN_API_KEY=SERVER_ONLY_SECRET
# DEV_PORT=5180
