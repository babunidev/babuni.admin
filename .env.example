# Babuni Admin is a loopback-only desktop development tool.
# No passwords or access tokens may be placed in VITE_-prefixed settings.
#
# Protected Morkahja game content: read locally and write only with a short-lived
# profile + dataset grant issued via npm run morkahja:content-grant.
# MORKAHJA_PUBLIC=/absolute/path/to/MorkahjaWebApp/client/public
# VITE_USE_LOCAL_CONTENT=true
# VITE_USE_PROTECTED_CONTENT=true
# VITE_MORKAHJA_PROFILE_ID=<uuid-of-morkahja-local-files-profile>
#
# SSH PostgreSQL: create a postgres-ssh profile in Connections, then configure
# nonsecret metadata via npm run morkahja:configure and store its DATABASE password
# via npm run credentials -- set <profile-uuid>. SSH auth uses the SSH agent or
# an explicitly configured private identity file. Do not put secrets in this file.
# The connection is established manually from the Connections screen.
#
# Legacy local DB/content write middleware is disabled outside isolated fixtures.
# Optional remote API proxy is not a production security boundary.
# VITE_API_BASE_URL=/game-data/admin
# LOCAL_ADMIN_PROXY_ENABLED=true
# API_PROXY_TARGET=https://example.invalid
# ADMIN_API_KEY=SERVER_ONLY_SECRET
# DEV_PORT=5180
